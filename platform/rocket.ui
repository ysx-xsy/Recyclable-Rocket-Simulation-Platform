          <string notr="true">/* 设置全局基础字体 */
QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei UI&quot;, sans-serif;
    line-height: 1.6; /* 增加行间距，防止文字堆叠 */
