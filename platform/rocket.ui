        <property name="styleSheet">
         <string notr="true">QListView {
    border-radius: 20px;           /* 将列表的外边框设为圆角（20像素）*/
    color: rgba(255, 255, 255,255);     /* 设置默认文字颜色为灰色 */
    background-color: transparent; /* 设置列表的背景为透明 */
}
QListView::item {
    background-color: transparent; /* 每个列表项的背景也是透明的 */
    height: 40px;                 /* 固定每个项的高度为40像素 */
    padding-left: 12px;           /* 项内的文字向左缩进12像素 */
}
QListView::item:hover {
    background-color: rgba(216, 216, 216, 0.5); /* 半透明的浅灰色背景 */
}
QListView::item:selected {
    background-color: rgba(180, 200, 255, 0.6);  /* 淡蓝色半透明背景 */
    color: rgba(255, 255, 255, 255);                      /* 深色文字 */
    border-left: 2px solid rgb(35, 149, 255);    /* 左侧添加蓝色指示条 */
}
QListView:focus {
    outline: none;
}</string>
