                  <property name="styleSheet">
                   <string notr="true">QRadioButton {
    spacing: 25px;          /* 文字与圆圈之间的间距 */
}
/* 2. 定制未选中时的圆圈样式 */
QRadioButton::indicator {
    width: 18px;           /* 圆圈宽度 */
    height: 18px;          /* 圆圈高度 */
    border-radius: 10px;    /* 设置为宽度的一半即为正圆 */
    border: 2px solid rgb(115, 115, 115); /* 边框颜色 */
    background-color: white;
}

/* 3. 定制选中时的圆圈样式 */
QRadioButton::indicator:checked {
    background-color: rgb(115, 115, 115); /* 选中后的中心颜色（绿色） */
    border: 2px solid rgb(115, 115, 115); /* 选中后的边框颜色 */
}</string>
                  </property>
                  <property name="text">
                   <string>Random state</string>
                  </property>
